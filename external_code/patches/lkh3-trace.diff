+/* SAVANT benchmark patch: print each new best feasible cost with the time
+   since start (same clock as TOTAL_TIME_LIMIT). Output only. */
+extern GainType TraceBest;
+#define TRACE_BEST(Pen, C) \
+    do { \
+        if ((Pen) == 0 && (C) < TraceBest) { \
+            TraceBest = (C); \
+            printff("TRACE %.3f " GainFormat "\n", GetTime() - StartTime, \
+                    TraceBest); \
