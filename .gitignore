# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local tooling and scratch notes
.claude/
cmd.txt
# reference implementation received by mail, kept locally only
code yann /
paper/
report/

# Run outputs (run.py writes one directory per run)
res/
results/

# Scratch space (reviews, ad-hoc measurements)
tmp/
sweep/
tests/
timing/

# Compiled solver (regenerate with make / make debug / make trace)
cw
cw_dbg
cw_trace
*.o
*.dSYM/

# Downloaded / generated instances — regenerate with:
#   python3 fetch_neuopt.py             -> data/
#   python3 mkedge.py edge              -> edge/
#   python3 tools/bundle_to_vrp.py ...  -> data/vrp_<n>/  (TSPLIB, for HGS)
data/
edge/

# Third-party solvers used as references, cloned and built locally:
#   git clone https://github.com/vidalt/HGS-CVRP.git external/HGS-CVRP
#   cmake -S external/HGS-CVRP -B external/HGS-CVRP/build -DCMAKE_BUILD_TYPE=Release
#   make -C external/HGS-CVRP/build bin
# The commit actually used is recorded in each run's config.json (hgs_commit).
external/

# LaTeX build artifacts (baseline.tex is regenerated by make_tex.py)
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz

# macOS
.DS_Store
